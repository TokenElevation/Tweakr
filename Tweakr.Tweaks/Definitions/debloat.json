  {
    "id": "debloat.consumer-features",
    "title": "Stop automatic app installs",
    "description": "Stop Windows from silently installing sponsored apps.",
    "category": "Debloat",
    "risk": "safe",
    "tags": [
      "privacy",
      "performance"
    ],
    "featured": true,
    "why": "Without this, Windows can install apps like Candy Crush or Spotify on its own after updates and for new accounts.",
    "operations": [
      {
        "type": "registry",
        "hive": "HKLM",
        "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
        "name": "DisableWindowsConsumerFeatures",
        "kind": "DWord",
        "on": 1,
        "off": "<delete>"
      }
    ]
  },
  {
