[
  {
    "id": "explorer.classic-context-menu",
    "title": "Classic context menu",
    "description": "Restore the full right-click menu instead of 'Show more options'.",
    "category": "UI / Explorer",
    "risk": "safe",
    "why": "Windows 11 hides many commands behind an extra click. This adds an empty per-user COM override so the old menu is used. Removing it brings the new menu back.",
    "os": {
      "minBuild": 22000
    },
    "operations": [
      {
        "type": "registry",
        "hive": "HKCU",
        "path": "Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
        "name": "(Default)",
        "kind": "String",
        "on": "",
        "off": "<delete-key>"
      }
    ],
    "postAction": "restartExplorer",
    "tags": [
      "appearance"
    ],
    "featured": true
  },
  {
