  {
    "id": "util.restart-ui",
    "title": "Windows Search and UI",
    "description": "Restart your Windows Search and UI to fix display issues. (May take a while)",
    "category": "Utilities",
    "page": "utilities",
    "section": "Quick fixes",
    "kind": "action",
    "risk": "safe",
    "icon": "\ue721",
    "buttonText": "Restart",
    "operations": [
      {
        "type": "killProcesses",
        "names": [
          "explorer",
          "SearchHost",
          "SearchApp",
          "StartMenuExperienceHost",
          "ShellExperienceHost"
        ],
        "message": "Windows is restarting its shell. Your taskbar will reappear in a moment."
      }
    ]
  },
